generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Card {
  cid         Int         @id
  password    String      @unique @db.VarChar(12)
  name        String      @db.VarChar(100)
  scName      String?     @map("sc_name") @db.VarChar(100)
  jpName      String?     @map("jp_name") @db.VarChar(100)
  enName      String?     @map("en_name") @db.VarChar(100)
  types       String?     @db.Text
  description String?     @db.Text
  weight      Int?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  images      CardImage[]
  printItems  PrintItem[]

  @@map("cards")
}

model CardImage {
  id         Int        @id @default(autoincrement())
  cardCid    Int        @map("card_cid")
  variant    String     @db.VarChar(16)
  sourceUrl  String     @map("source_url") @db.VarChar(512)
  width      Int?
  height     Int?
  checksum   String?    @db.Char(64)
  status     ImageStatus @default(UNKNOWN)
  checkedAt  DateTime?  @map("checked_at")
  card       Card       @relation(fields: [cardCid], references: [cid], onDelete: Cascade)

  @@unique([cardCid, variant])
  @@index([status, checkedAt])
  @@map("card_images")
}

enum ImageStatus {
  UNKNOWN
  READY
  MISSING
  INVALID
}

model PrintProject {
  id        String      @id @default(uuid()) @db.Char(36)
  tokenHash String      @unique @map("token_hash") @db.Char(64)
  revision  Int         @default(0)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  expiresAt DateTime    @map("expires_at")
  items     PrintItem[]
  exports   ExportJob[]

  @@index([expiresAt])
  @@map("print_projects")
}

model PrintItem {
  id        Int          @id @default(autoincrement())
  projectId String       @map("project_id") @db.Char(36)
  cardCid   Int          @map("card_cid")
  variant   String       @db.VarChar(16)
  quantity  Int          @db.TinyInt
  position  Int
  project   PrintProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  card      Card         @relation(fields: [cardCid], references: [cid])

  @@unique([projectId, cardCid, variant])
  @@index([projectId, position])
  @@map("print_items")
}

model ExportJob {
  id            String       @id @db.Char(36)
  projectId     String       @map("project_id") @db.Char(36)
  status        ExportStatus @default(QUEUED)
  itemsSnapshot Json         @map("items_snapshot")
  total         Int
  pageCount     Int          @map("page_count")
  fileName      String?      @map("file_name") @db.VarChar(255)
  fileKey       String?      @map("file_key") @db.VarChar(255)
  error         String?      @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  expiresAt     DateTime     @map("expires_at")
  project       PrintProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([projectId, createdAt])
  @@map("export_jobs")
}

enum ExportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}
